# Local one-shot build & run image for One-KVM (x86_64 Linux containers).
# Usage:
#   docker build -f build/Dockerfile.local -t one-kvm:local .
#   docker run -d --name one-kvm -p 8080:8080 -v one-kvm-data:/etc/one-kvm one-kvm:local
#
# Stage 1 builds the web frontend, stage 2 compiles the Rust backend using the
# prebuilt one-kvm-cross:x86_64 toolchain image (see build/cross/Dockerfile.x86_64),
# stage 3 is a slim Debian 11 runtime.

FROM node:22-bookworm-slim AS web
WORKDIR /build/web
COPY web/package.json web/package-lock.json* ./
RUN npm install --no-audit --no-fund
COPY web ./
RUN npm run build

FROM one-kvm-cross:x86_64 AS builder
WORKDIR /build
ENV PKG_CONFIG_ALLOW_CROSS=1 FFMPEG_STATIC=1 LIBYUV_STATIC=1
COPY Cargo.toml build.rs vcpkg.json vcpkg-configuration.json ./
COPY protos ./protos
COPY libs ./libs
COPY res/vcpkg ./res/vcpkg
COPY src ./src
COPY --from=web /build/web/dist ./web/dist
RUN cargo build --release --bin one-kvm

FROM debian:11-slim
RUN sed -i 's/ main$/ main contrib non-free/' /etc/apt/sources.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        libudev1 \
        libasound2 \
        network-manager \
        iproute2 \
        iputils-ping \
        libv4l-0 \
        libva2 libva-drm2 libva-x11-2 \
        libx11-6 libxcb1 libxau6 libxdmcp6 libmfx1 \
        && rm -rf /var/lib/apt/lists/* && \
    mkdir -p /etc/one-kvm/ventoy
COPY --from=builder /build/target/release/one-kvm /usr/bin/one-kvm
# build/init.sh has CRLF line endings on Windows checkouts; invoke the binary directly.
ENTRYPOINT ["/usr/bin/one-kvm", "-d", "/etc/one-kvm"]
